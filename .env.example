# ==============================================================================
# PhishScope SOC - Production Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your production secrets.
# NEVER commit your populated '.env' file to Git or version control!
# ==============================================================================

# ----------------- Core Application & Session Security -----------------
FLASK_ENV=production
FLASK_DEBUG=0
# Generate a cryptographically secure 64-character secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
JWT_SECRET_KEY=replace_with_another_secure_random_64_character_hex_string
JWT_EXPIRATION_HOURS=8

# ----------------- Database Configuration -----------------
# SQLite default (or postgresql://user:password@localhost:5432/phishscope)
DATABASE_URL=sqlite:///email_investigation.db

# ----------------- Network & CORS Boundaries -----------------
# Comma-separated list of allowed frontend origins (No wildcards in production)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5000,http://localhost:5000

# ----------------- Authentication & Access Control -----------------
# Set to 'true' to strictly enforce JWT / API Key authentication across all endpoints
ENABLE_AUTH=false
API_KEY=replace_with_production_analyst_api_key_32_chars
ADMIN_API_KEY=replace_with_production_admin_api_key_32_chars
MAX_FAILED_LOGINS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ----------------- Rate Limiting -----------------
ENABLE_RATE_LIMITING=true
RATELIMIT_DEFAULT=120 per minute
RATELIMIT_UPLOAD=30 per minute
RATELIMIT_AUTH=10 per minute

# ----------------- Upload & Storage Constraints -----------------
MAX_UPLOAD_SIZE_MB=25

# ----------------- Splunk Enterprise SIEM Integration -----------------
SPLUNK_HOST=127.0.0.1
SPLUNK_PORT=8089
SPLUNK_USERNAME=botnet
SPLUNK_PASSWORD=
SPLUNK_TOKEN=
SPLUNK_INDEX=sysmon
SPLUNK_INDEXES=sysmon,windows,powershell
# Set SPLUNK_SSL_VERIFY=true or supply path to custom CA certificate bundle in production
SPLUNK_SSL_VERIFY=false
SPLUNK_CA_BUNDLE=

# ----------------- Wazuh EDR Integration (Optional) -----------------
WAZUH_HOST=
WAZUH_PORT=55000
WAZUH_USER=
WAZUH_PASSWORD=
WAZUH_SSL_VERIFY=false

# ----------------- Threat Intelligence Feeds (Optional) -----------------
# Note: If keys are left blank, PhishScope operates smoothly in Safe Degraded Mode
# (Local DNS, RDAP, static file magic, and heuristic scoring work 100% offline!)
#
# Free API Key Links:
# - VirusTotal: https://www.virustotal.com/gui/my-apikey
# - AbuseIPDB:  https://www.abuseipdb.com/account/api
# - URLScan:    https://urlscan.io/user/profile
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=

# ----------------- AI-Powered Investigation (Optional) -----------------
OPENAI_API_KEY=
AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
