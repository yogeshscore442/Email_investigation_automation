# Exclude credentials and environment files
.env
.env.*
!.env.example
*.key
*.pem
*.token

# Exclude local database files
*.db
*.sqlite3
backend/data/storage/*
!backend/data/storage/.gitkeep
backend/data/backups/*

# Exclude node_modules and builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Exclude Python bytecode and virtualenvs
__pycache__/
*.pyc
venv/
.venv/
backend/venv/

# Exclude Git & caches
.git/
.pytest_cache/
*.log
