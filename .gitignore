# ==========================================
# PhishScope SOC - Git Ignore Rules
# ==========================================

# Environment & Credentials (NEVER commit secrets!)
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
*.pem
*.key
*.token

# Databases & User Investigation Data (NO USER DATA)
instance/
backend/instance/
*.db
*.sqlite
*.sqlite3
*.bak
*.pre_restore.*

# Storage & Uploaded Evidence (Do NOT share our data)
backend/data/storage/*
!backend/data/storage/.gitkeep
backend/data/backups/*
!backend/data/backups/.gitkeep
backend/data/samples/*
!backend/data/samples/.gitkeep
backend/data/phase5_lab/
data/storage/*
data/backups/*
data/samples/*
backend/data/*.pdf
backend/data/*.json
*.eml
*.msg
*.pcap

# Internal Audit & Phase Reports (Excluded from public repo)
phase*.md
FINAL_PROJECT_COMPLETION_REPORT.md
navigation_bug_fix_report.md
phishscope_final_project_report.md

# Python Caches & Virtual Environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend Build
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log
logs/
backend/logs/

# IDE, OS, & Shortcuts
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.lnk
